# Copy this file to .env and fill in your values
# Never commit .env to git

TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
OWNER_CHAT_ID=your_telegram_user_id
POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/dbname
BROADCAST_CHANNEL_ID=        # your private channel ID e.g. -1001234567890
SCAN_INTERVAL_MINUTES=60     # how often to scan (minutes)

# Optional risk guards (defaults shown)
CIRCUIT_BREAKER=1            # pause a symbol after 3 stop losses in a row, pause everything after a -4R day
CORRELATION_GUARD=1          # skip an alert that repeats an open trade on a correlated symbol
REGIME_GATE=0                # skip entries in range / quiet / shock regimes. Backtest before turning on

# Optional: spot gold prices from Twelve Data instead of Yahoo gold futures.
# Free key at https://twelvedata.com (800 requests a day). Leave empty to stay on Yahoo.
TWELVE_DATA_API_KEY=

# Copy this file to .env and fill in your values
# Never commit .env to git

TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
OWNER_CHAT_ID=your_telegram_user_id
POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/dbname
BROADCAST_CHANNEL_ID=        # your private channel ID e.g. -1001234567890
SCAN_INTERVAL_MINUTES=60     # how often to scan (minutes)
